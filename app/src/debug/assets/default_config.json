{
  "version": 2,
  "settings": {
    "rotateThreshold": 3,
    "invertRotation": true,
    "sequenceTimeoutMs": 3000,
    "textDelayMs": 40,
    "captureUnknownInput": true,
    "forceLoggingTransport": false,
    "gestureSensorsEnabled": false,
    "keepAliveService": true,
    "sensorToSymbol": {}
  },
  "activeProfile": "keys",
  "profiles": [
    {
      "id": "keys",
      "name": "直控",
      "kind": "KEYS",
      "single": {
        "U": { "key": "W" },
        "D": { "key": "S" },
        "L": { "key": "A" },
        "R": { "key": "D" },
        "CW": { "mouse": { "wheel": -1 } },
        "CCW": { "mouse": { "wheel": 1 } },
        "S": { "click": "left" },
        "SL": { "combo": "alt+tab" }
      },
      "macros": []
    },
    {
      "id": "macro",
      "name": "宏",
      "kind": "MACRO",
      "single": {
        "CW": { "mouse": { "wheel": -1 } },
        "CCW": { "mouse": { "wheel": 1 } },
        "S": { "click": "left" }
      },
      "macros": [
        {
          "id": "demo1",
          "name": "示例序列",
          "seq": "U R D D D CW",
          "enabled": true,
          "steps": [ { "key": "1" }, { "delay": 120 }, { "click": "left" } ]
        },
        {
          "id": "demo2",
          "name": "文本输入",
          "seq": "U U D L R",
          "enabled": true,
          "steps": [ { "text": "HELLO" }, { "key": "ENTER" } ]
        },
        {
          "id": "demo3",
          "name": "媒体键",
          "seq": "D U R R L D CCW",
          "enabled": true,
          "steps": [ { "consumer": "PLAY_PAUSE" } ]
        },
        {
          "id": "demo4",
          "name": "禁用示例",
          "seq": "L U R D CW",
          "enabled": false,
          "steps": [ { "key": "4" } ]
        }
      ]
    }
  ]
}
